{
  "name": "marswalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:phone": "cross-env MARSWALK_HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "data:download": ".venvScriptspython scripts/download_data.py",
    "data:process": ".venvScriptspython scripts/process_data.py && .venvScriptspython scripts/positions.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
